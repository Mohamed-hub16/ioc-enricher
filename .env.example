# === APIs d'enrichissement ===
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GROQ_API_KEY=

# GreyNoise Community (free) — distingue scanners Internet vs IPs ciblées
# https://docs.greynoise.io/docs/using-the-greynoise-community-api
GREYNOISE_API_KEY=

# abuse.ch Auth-Key partagée par URLhaus, ThreatFox, MalwareBazaar
# https://auth.abuse.ch/
ABUSE_CH_API_KEY=

# === Modèle IA (optionnel — défaut: llama-3.3-70b-versatile) ===
GROQ_MODEL=llama-3.3-70b-versatile

# === Flask ===
SECRET_KEY=
ADMIN_EMAIL=

# === Auto-deploy (webhook GitHub) ===
DEPLOY_SECRET=                # secret défini dans GitHub → Settings → Webhooks
PA_API_TOKEN=                 # PythonAnywhere → Account → API token
PA_USERNAME=                  # votre username PythonAnywhere
PA_DOMAIN=                    # ex: username.pythonanywhere.com
